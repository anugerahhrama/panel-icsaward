# Copy ke `.env` di server. Generate APP_KEY SEKALI lewat
# `docker compose run --rm app php artisan key:generate --show`
# dan jangan diubah lagi — regenerasi merusak session & data terenkripsi.

APP_NAME="ICS Award 2026"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example

# Domain tanpa https:// — dipakai rule Host() Traefik di docker-compose.yml.
APP_DOMAIN=your-domain.example

# Diisi otomatis oleh scripts/deploy.sh (git short hash). Jangan diedit manual.
IMAGE_TAG=latest

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# MySQL (bukan PostgreSQL): rule .ai/rules/database.md ditulis untuk MySQL, dan raw SQL
# skor juri (`sum(raw_score * weight) / 100`) baru benar di MySQL — SQLite/PostgreSQL
# membulatkan pembagian integer.
# DB_PASSWORD: generate dengan `openssl rand -base64 24` (min. 16 karakter).
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
# Hanya dipakai container MySQL (healthcheck) — generate terpisah dari DB_PASSWORD.
DB_ROOT_PASSWORD=change-me-too
DB_DATABASE=regis_icsa2026
DB_USERNAME=regis_icsa2026
DB_PASSWORD=change-me

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true

# Email konfirmasi, keputusan verifikasi & pengumuman dikirim lewat queue
# (container "worker"). Tanpa worker, email tidak pernah terkirim.
QUEUE_CONNECTION=database
CACHE_STORE=database

# Migration otomatis saat container app start (docker/entrypoint.sh).
RUN_MIGRATIONS=true

# WAJIB SMTP asli di production (konfirmasi pendaftaran, verifikasi, pengumuman finalis).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@your-domain.example"
MAIL_FROM_NAME="${APP_NAME}"

# Paper peserta disimpan di disk privat (storage/app/private), template unduhan di
# disk public — keduanya di volume Docker regis-icsa2026-storage. Jangan `down -v`.
# Batas upload PHP diset 100 MB di docker/php.ini (maks. setting paper_max_size_mb).
FILESYSTEM_DISK=local

VITE_APP_NAME="${APP_NAME}"

# Prefix URL panel admin. WAJIB diganti ke nilai privat, mis. `panel-$(openssl rand -hex 4)`.
ADMIN_PANEL_PREFIX=change-me

# Google OAuth (login peserta). Daftarkan "${APP_URL}/auth/google/callback" sebagai
# authorized redirect URI di Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
